<Window x:Class="SoundPadZ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:SoundPadZ.ViewModels"
        Title="SoundPadZ" Height="760" Width="1220" MinHeight="620" MinWidth="1000"
        Icon="logo.png"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="Segoe UI" TextElement.FontSize="13"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <DockPanel>
        <!-- App bar -->
        <md:ColorZone DockPanel.Dock="Top" Mode="PrimaryLight" Padding="18,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="6" Background="White" Margin="0,0,2,0" VerticalAlignment="Center">
                        <TextBlock Text="spz" FontSize="14" FontWeight="Bold" Foreground="#191E2D"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                    </Border>
                    <TextBlock Text="SoundPadZ" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnPalette" Style="{StaticResource MaterialDesignIconButton}"
                            Click="PaletteButton_Click" Width="34" Height="34" Padding="0" Margin="0,0,6,0"
                            ToolTip="{DynamicResource PaletteTooltip}">
                        <md:PackIcon Kind="Palette" Width="20" Height="20"/>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="PaletteMenu">
                                <MenuItem Header="{DynamicResource Color_Sky}" Click="AccentMenu_Click" Tag="#90CAF9">
                                    <MenuItem.Icon>
                                        <Border Width="14" Height="14" CornerRadius="7" Background="#90CAF9" BorderBrush="#5FA5DD" BorderThickness="1"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{DynamicResource Color_Mint}" Click="AccentMenu_Click" Tag="#81C784">
                                    <MenuItem.Icon>
                                        <Border Width="14" Height="14" CornerRadius="7" Background="#81C784" BorderBrush="#4CAF50" BorderThickness="1"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{DynamicResource Color_Purple}" Click="AccentMenu_Click" Tag="#B39DDB">
                                    <MenuItem.Icon>
                                        <Border Width="14" Height="14" CornerRadius="7" Background="#B39DDB" BorderBrush="#7E57C2" BorderThickness="1"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{DynamicResource Color_Pink}" Click="AccentMenu_Click" Tag="#F48FB1">
                                    <MenuItem.Icon>
                                        <Border Width="14" Height="14" CornerRadius="7" Background="#F48FB1" BorderBrush="#E91E63" BorderThickness="1"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{DynamicResource Color_Orange}" Click="AccentMenu_Click" Tag="#FFB74D">
                                    <MenuItem.Icon>
                                        <Border Width="14" Height="14" CornerRadius="7" Background="#FFB74D" BorderBrush="#FB8C00" BorderThickness="1"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{DynamicResource Color_Cyan}" Click="AccentMenu_Click" Tag="#80DEEA">
                                    <MenuItem.Icon>
                                        <Border Width="14" Height="14" CornerRadius="7" Background="#80DEEA" BorderBrush="#26A69A" BorderThickness="1"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{DynamicResource Color_Red}" Click="AccentMenu_Click" Tag="#E57373">
                                    <MenuItem.Icon>
                                        <Border Width="14" Height="14" CornerRadius="7" Background="#E57373" BorderBrush="#D32F2F" BorderThickness="1"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{DynamicResource Color_Amber}" Click="AccentMenu_Click" Tag="#FFE082">
                                    <MenuItem.Icon>
                                        <Border Width="14" Height="14" CornerRadius="7" Background="#FFE082" BorderBrush="#FFA000" BorderThickness="1"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="{DynamicResource Color_Custom}" Click="CustomColorMenu_Click">
                                    <MenuItem.Icon>
                                        <md:PackIcon Kind="Eyedropper" Width="16" Height="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="BtnWelcome" Style="{StaticResource MaterialDesignIconButton}"
                            Click="Welcome_Click" Width="34" Height="34" Padding="0" Margin="0,0,6,0"
                            ToolTip="{DynamicResource ShowWelcomeTooltip}">
                        <md:PackIcon Kind="HelpCircleOutline" Width="20" Height="20"/>
                    </Button>
                    <Button x:Name="BtnAutoStart" Style="{StaticResource MaterialDesignIconButton}"
                            Click="AutoStart_Click" Width="34" Height="34" Padding="0" Margin="0,0,6,0"
                            ToolTip="{DynamicResource AutoStartTooltip}">
                        <md:PackIcon x:Name="AutoStartIcon" Kind="RocketLaunchOutline" Width="20" Height="20"/>
                    </Button>
                    <Button x:Name="BtnTheme" Style="{StaticResource MaterialDesignIconButton}"
                            Click="ThemeToggle_Click" Width="34" Height="34" Padding="0" Margin="0,0,10,0"
                            ToolTip="{DynamicResource ThemeToggle}">
                        <md:PackIcon x:Name="ThemeIcon" Kind="WeatherNight" Width="20" Height="20"/>
                    </Button>
                    <RadioButton x:Name="RbRu" Content="RU" Margin="0,0,6,0"
                                 Style="{StaticResource MaterialDesignChoiceChipRadioButton}"
                                 Checked="RbRu_Checked"/>
                    <RadioButton x:Name="RbEn" Content="EN" Margin="0,0,16,0"
                                 Style="{StaticResource MaterialDesignChoiceChipRadioButton}"
                                 Checked="RbEn_Checked"/>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" Click="StopAll_Click">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Stop" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource StopAll}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </md:ColorZone>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="316"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left panel -->
            <Border Grid.Column="0"
                    Background="{DynamicResource AppSidePanelBackground}"
                    BorderBrush="{DynamicResource AppSidePanelBorder}"
                    BorderThickness="0,1,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">

                        <!-- Output device -->
                        <md:Card UniformCornerRadius="14" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Kind="VolumeHigh" Width="18" Height="18"
                                                     VerticalAlignment="Center" Foreground="{DynamicResource AppAccentDarkBrush}"/>
                                        <TextBlock Text="{DynamicResource OutputDevice}" FontWeight="SemiBold"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            HorizontalAlignment="Right" Click="RefreshDevices_Click"
                                            ToolTip="{DynamicResource Refresh}" Width="30" Height="30" Padding="0">
                                        <md:PackIcon Kind="Refresh" Width="18" Height="18"/>
                                    </Button>
                                </Grid>
                                <ComboBox x:Name="CbOutput" DisplayMemberPath="Name"
                                          SelectionChanged="CbOutput_SelectionChanged"/>
                                <TextBlock Text="{DynamicResource CableHint}" FontSize="11" Opacity="0.65"
                                           TextWrapping="Wrap" Margin="2,8,2,0"/>
                            </StackPanel>
                        </md:Card>

                        <!-- Monitor device (Headphones) -->
                        <md:Card UniformCornerRadius="14" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <md:PackIcon Kind="Headphones" Width="18" Height="18"
                                                 VerticalAlignment="Center" Foreground="{DynamicResource AppAccentDarkBrush}"/>
                                    <TextBlock Text="{DynamicResource MonitorDevice}" FontWeight="SemiBold"
                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ComboBox x:Name="CbMonitor" DisplayMemberPath="Name"
                                          SelectionChanged="CbMonitor_SelectionChanged"/>
                                <TextBlock Text="{DynamicResource MonitorHint}" FontSize="11" Opacity="0.65"
                                           TextWrapping="Wrap" Margin="2,8,2,0"/>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{DynamicResource MonitorVolume}" FontSize="12" Opacity="0.8"/>
                                    <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold"
                                               Text="{Binding Value, ElementName=SlMonitorVol, StringFormat={}{0:P0}}"/>
                                    <Slider x:Name="SlMonitorVol" Grid.Row="1" Grid.ColumnSpan="2"
                                            Minimum="0" Maximum="1" Value="0.85" Margin="0,4,0,0"
                                            ValueChanged="SlMonitorVol_ValueChanged"/>
                                </Grid>
                            </StackPanel>
                        </md:Card>

                        <!-- Microphone -->
                        <md:Card UniformCornerRadius="14" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <md:PackIcon Kind="Microphone" Width="18" Height="18"
                                                 VerticalAlignment="Center" Foreground="{DynamicResource AppAccentDarkBrush}"/>
                                    <TextBlock Text="{DynamicResource Microphone}" FontWeight="SemiBold"
                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ComboBox x:Name="CbMic" DisplayMemberPath="Name" Margin="0,0,0,10"
                                          SelectionChanged="CbMic_SelectionChanged"/>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="TgMic"
                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  Checked="TgMic_Checked" Unchecked="TgMic_Unchecked"
                                                  VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource MicToCable}" Margin="10,0,0,0"
                                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource MicHint}" FontSize="11" Opacity="0.65"
                                           TextWrapping="Wrap" Margin="2,8,2,0"/>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{DynamicResource MicVolume}" FontSize="12" Opacity="0.8"/>
                                    <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold"
                                               Text="{Binding Value, ElementName=SlMicVol, StringFormat={}{0:P0}}"/>
                                    <Slider x:Name="SlMicVol" Grid.Row="1" Grid.ColumnSpan="2"
                                            Minimum="0" Maximum="1" Value="0.9" Margin="0,4,0,0"
                                            ValueChanged="SlMicVol_ValueChanged"/>
                                </Grid>
                            </StackPanel>
                        </md:Card>

                        <!-- Library -->
                        <md:Card UniformCornerRadius="14" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <md:PackIcon Kind="PlaylistPlus" Width="18" Height="18"
                                                 VerticalAlignment="Center" Foreground="{DynamicResource AppAccentDarkBrush}"/>
                                    <TextBlock Text="{DynamicResource AddTitle}" FontWeight="SemiBold"
                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Style="{StaticResource MaterialDesignRaisedButton}" Click="AddFiles_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Kind="PlaylistPlus" Width="18" Height="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource AddFiles}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,8,0,0"
                                        Click="AddUrl_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Kind="Link" Width="18" Height="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource AddUrl}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{DynamicResource DragHint}" FontSize="11" Opacity="0.6"
                                           TextWrapping="Wrap" Margin="2,10,2,0"/>
                            </StackPanel>
                        </md:Card>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Sounds grid -->
            <Grid Grid.Column="1" Margin="0,0,0,0">
                <ScrollViewer Padding="14" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="LstSounds">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SoundItemViewModel}">
                                <md:Card UniformCornerRadius="14" Margin="6" Width="232" Padding="14,12">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                                       HorizontalAlignment="Left" MaxWidth="110" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Click="TileHotkey_Click"
                                                        PreviewKeyDown="TileHotkey_PreviewKeyDown"
                                                        LostFocus="TileHotkey_LostFocus"
                                                        Cursor="Hand"
                                                        Padding="0" Height="24"
                                                        ToolTip="{DynamicResource HotkeyButtonTooltip}"
                                                        Style="{StaticResource MaterialDesignFlatButton}">
                                                    <Border CornerRadius="8" Padding="6,2"
                                                            Background="{DynamicResource PrimaryHueLightBrush}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <md:PackIcon Kind="Keyboard" Width="12" Height="12" Margin="0,0,3,0" VerticalAlignment="Center"
                                                                         Foreground="{DynamicResource PrimaryHueLightForegroundBrush}"/>
                                                            <TextBlock Text="{Binding HotkeyDisplayButtonText}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource PrimaryHueLightForegroundBrush}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Button>
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        Click="TileClearHotkey_Click"
                                                        Visibility="{Binding ClearHotkeyVisibility}"
                                                        Width="20" Height="20" Padding="0" Margin="2,0,0,0"
                                                        ToolTip="{DynamicResource ClearHotkeyTooltip}">
                                                    <md:PackIcon Kind="Close" Width="12" Height="12" Opacity="0.6"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding DurationText}" FontSize="11" Opacity="0.55"
                                                   Margin="1,3,0,0"/>

                                        <Grid Margin="0,12,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton Style="{StaticResource MaterialDesignFlatToggleButton}"
                                                          IsChecked="{Binding Loop}" ToolTip="{DynamicResource LoopTooltip}"
                                                          Width="36" Height="36" Padding="0">
                                                <md:PackIcon Kind="Repeat" Width="18" Height="18"/>
                                            </ToggleButton>
                                            <Button Grid.Column="1" Click="TilePlay_Click"
                                                    Style="{StaticResource MaterialDesignFloatingActionButton}"
                                                    Width="52" Height="52" HorizontalAlignment="Center"
                                                    ToolTip="{DynamicResource PlayTooltip}">
                                                <md:PackIcon Kind="{Binding PlayPauseIcon}" Width="24" Height="24"/>
                                            </Button>
                                            <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                                    Click="TileDelete_Click" ToolTip="{DynamicResource RemoveTooltip}"
                                                    Width="36" Height="36" Padding="0">
                                                <md:PackIcon Kind="Delete" Width="18" Height="18"/>
                                            </Button>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <md:PackIcon Kind="VolumeMedium" Width="16" Height="16"
                                                         VerticalAlignment="Center" Opacity="0.55"/>
                                            <Slider Grid.Column="1" Minimum="0" Maximum="1.5" SmallChange="0.05" LargeChange="0.1"
                                                    Value="{Binding Volume}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                    ToolTip="{Binding VolumePercentText}"
                                                    AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="0"/>
                                        </Grid>
                                    </StackPanel>
                                    <md:Card.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{DynamicResource ClearHotkey}" Click="TileClearHotkey_Click"
                                                      Visibility="{Binding ClearHotkeyVisibility}">
                                                <MenuItem.Icon>
                                                    <md:PackIcon Kind="KeyboardOff"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{DynamicResource Remove}" Click="TileDelete_Click">
                                                <MenuItem.Icon>
                                                    <md:PackIcon Kind="Delete"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </md:Card.ContextMenu>
                                </md:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center"
                            VerticalAlignment="Center" IsHitTestVisible="False">
                    <md:PackIcon Kind="Equalizer" Width="72" Height="72" HorizontalAlignment="Center" Opacity="0.35"/>
                    <TextBlock Text="{DynamicResource EmptySounds}" HorizontalAlignment="Center" FontSize="15"
                               Margin="0,10,0,0" Opacity="0.7"/>
                    <TextBlock Text="{DynamicResource EmptySoundsHint}" HorizontalAlignment="Center" FontSize="12"
                               Margin="0,4,0,0" Opacity="0.5"/>
                </StackPanel>

                <md:Snackbar x:Name="MainSnackbar" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                             Margin="16"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
