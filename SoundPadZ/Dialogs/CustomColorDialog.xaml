<Window x:Class="SoundPadZ.Dialogs.CustomColorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="SoundPadZ"
        Width="440" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="Segoe UI">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource CustomColorTitle}" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="{DynamicResource CustomColorSubtitle}" FontSize="12" Opacity="0.65" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Live Preview Card -->
        <Border Grid.Row="1" x:Name="PreviewBorder" Height="54" CornerRadius="10" Margin="0,0,0,14"
                BorderThickness="1" BorderBrush="#33FFFFFF" Padding="14,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtPreview" Text="SoundPadZ Accent Preview" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Background="#40000000" CornerRadius="6" Padding="8,3">
                    <TextBlock x:Name="TxtHexBadge" Text="#90CAF9" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                </Border>
            </Grid>
        </Border>

        <!-- HEX Input -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TbHex" md:HintAssist.Hint="{DynamicResource HexCode}"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     FontSize="13" TextChanged="TbHex_TextChanged" MaxLength="9"/>
        </Grid>

        <!-- Quick Palette Swatches -->
        <StackPanel Grid.Row="3" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource QuickColors}" FontSize="11.5" FontWeight="SemiBold" Opacity="0.75" Margin="0,0,0,6"/>
            <WrapPanel x:Name="SwatchesPanel" ItemWidth="30" ItemHeight="30"/>
        </StackPanel>

        <!-- RGB Sliders -->
        <StackPanel Grid.Row="4" VerticalAlignment="Top" Margin="0,0,0,10">
            <!-- R -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource RedChannel}" FontSize="12" VerticalAlignment="Center" Opacity="0.85"/>
                <Slider Grid.Column="1" x:Name="SlR" Minimum="0" Maximum="255" SmallChange="1" LargeChange="10"
                        ValueChanged="RgbSlider_ValueChanged" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SlR, StringFormat={}{0:0}}"
                           FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- G -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource GreenChannel}" FontSize="12" VerticalAlignment="Center" Opacity="0.85"/>
                <Slider Grid.Column="1" x:Name="SlG" Minimum="0" Maximum="255" SmallChange="1" LargeChange="10"
                        ValueChanged="RgbSlider_ValueChanged" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SlG, StringFormat={}{0:0}}"
                           FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- B -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource BlueChannel}" FontSize="12" VerticalAlignment="Center" Opacity="0.85"/>
                <Slider Grid.Column="1" x:Name="SlB" Minimum="0" Maximum="255" SmallChange="1" LargeChange="10"
                        ValueChanged="RgbSlider_ValueChanged" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SlB, StringFormat={}{0:0}}"
                           FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource MaterialDesignOutlinedButton}" Content="{DynamicResource Cancel}"
                    Click="Cancel_Click" Margin="0,0,10,0" Width="95" Height="36"/>
            <Button Style="{StaticResource MaterialDesignRaisedButton}" Content="{DynamicResource Apply}"
                    Click="Apply_Click" IsDefault="True" Width="105" Height="36" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
