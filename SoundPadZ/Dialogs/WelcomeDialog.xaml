<Window x:Class="SoundPadZ.Dialogs.WelcomeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="SoundPadZ"
        Width="580" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                <Border Width="34" Height="34" CornerRadius="8" Background="White" Margin="0,0,12,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="spz" FontSize="16" FontWeight="Bold" Foreground="#191E2D"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                </Border>
                <TextBlock Text="{DynamicResource WelcomeTitle}" FontSize="20" FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{DynamicResource WelcomeSubtitle}" FontSize="12.5" Opacity="0.65" Margin="46,0,0,0"/>
        </StackPanel>

        <!-- Features list -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
            <StackPanel>
                <!-- Feature 1 -->
                <md:Card UniformCornerRadius="12" Padding="14,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <md:PackIcon Kind="VolumeHigh" Width="22" Height="22"
                                     Foreground="{DynamicResource AppAccentDarkBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                            <TextBlock Text="{DynamicResource FeatureAudioTitle}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{DynamicResource FeatureAudioDesc}" FontSize="11.5" Opacity="0.75"
                                       TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="16"/>
                        </StackPanel>
                    </Grid>
                </md:Card>

                <!-- Feature 2 -->
                <md:Card UniformCornerRadius="12" Padding="14,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <md:PackIcon Kind="Headphones" Width="22" Height="22"
                                     Foreground="{DynamicResource AppAccentDarkBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                            <TextBlock Text="{DynamicResource FeatureMonitorTitle}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{DynamicResource FeatureMonitorDesc}" FontSize="11.5" Opacity="0.75"
                                       TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="16"/>
                        </StackPanel>
                    </Grid>
                </md:Card>

                <!-- Feature 3 -->
                <md:Card UniformCornerRadius="12" Padding="14,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <md:PackIcon Kind="Keyboard" Width="22" Height="22"
                                     Foreground="{DynamicResource AppAccentDarkBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                            <TextBlock Text="{DynamicResource FeatureHotkeyTitle}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{DynamicResource FeatureHotkeyDesc}" FontSize="11.5" Opacity="0.75"
                                       TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="16"/>
                        </StackPanel>
                    </Grid>
                </md:Card>

                <!-- Feature 4 -->
                <md:Card UniformCornerRadius="12" Padding="14,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <md:PackIcon Kind="PlaylistPlus" Width="22" Height="22"
                                     Foreground="{DynamicResource AppAccentDarkBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                            <TextBlock Text="{DynamicResource FeatureAddTitle}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{DynamicResource FeatureAddDesc}" FontSize="11.5" Opacity="0.75"
                                       TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="16"/>
                        </StackPanel>
                    </Grid>
                </md:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- VB-Cable download button -->
        <Button Grid.Row="2" Style="{StaticResource MaterialDesignOutlinedButton}"
                Click="DownloadCable_Click" Margin="0,0,0,16" Height="38">
            <StackPanel Orientation="Horizontal">
                <md:PackIcon Kind="Download" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{DynamicResource DownloadCableBtn}" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>
        </Button>

        <!-- Footer -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="ChkDontShow" Content="{DynamicResource DontShowAgain}"
                      IsChecked="True" VerticalAlignment="Center" FontSize="12"/>
            <Button Grid.Column="1" Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="GotIt_Click" Content="{DynamicResource GotItBtn}"
                    Padding="20,0" Height="36" FontWeight="SemiBold"/>
        </Grid>
    </Grid>
</Window>
